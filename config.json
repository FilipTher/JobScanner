{
  "port": 3000,
  "userAgent": "JobScanner/1.0 (personal job search tool; +https://github.com/FilipTher/JobScanner)",
  "requestGapMs": 800,
  "cities": ["Hradec Králové", "Pardubice"],
  "companyDistricts": ["CZ0521", "CZ0531"],
  "allowRemote": true,
  "slovakiaRemoteOnly": true,
  "sources": {
    "jobsCz": {
      "enabled": true,
      "professions": ["programator"],
      "maxPages": 20
    },
    "startupjobs": {
      "enabled": true,
      "recheckDays": 3,
      "maxPages": 60
    }
  }
}
